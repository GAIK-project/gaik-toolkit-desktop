{
  "name": "gaik-toolkit-desktop",
  "version": "0.1.0",
  "description": "Experimental desktop app for the GAIK Toolkit: extract, parse, classify and transcribe local files with your own model key",
  "author": "GAIK Project",
  "license": "MIT",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "typecheck": "tsc --noEmit",
    "check": "node --check src/main.js && node --check src/preload.js && node --test && tsc --noEmit",
    "pack": "node scripts/bundle-uv.mjs && vite build && electron-builder --dir",
    "dist": "node scripts/bundle-uv.mjs && vite build && electron-builder --publish never",
    "test:engine": "python -m pytest sidecar/test_offline.py -q",
    "bundle:uv": "node scripts/bundle-uv.mjs"
  },
  "build": {
    "appId": "fi.gaik.toolkit.desktop",
    "productName": "GAIK Desktop",
    "files": [
      "src/**/*",
      "dist/renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "sidecar",
        "to": "sidecar",
        "filter": [
          "server.py",
          "requirements.txt"
        ]
      },
      {
        "from": "build/bin",
        "to": "bin"
      },
      {
        "from": "samples",
        "to": "samples"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "GAIK-Desktop-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "directories": {
      "output": "release"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
